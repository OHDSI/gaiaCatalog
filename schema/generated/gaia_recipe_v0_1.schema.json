        "monthly",
        "as_needed"
      ],
      "title": "UpdateFrequencyEnum",
      "type": "string"
    },
    "Variable": {
      "additionalProperties": false,
      "description": "One variable, both a schema.org PropertyValue and a CDIF InstanceVariable.",
      "properties": {
        "@id": {
          "type": [
            "string",
            "null"
