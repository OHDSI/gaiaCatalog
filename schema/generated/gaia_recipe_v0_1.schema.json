      "required": [
        "@context",
        "@id",
        "@type",
        "schema:identifier",
        "schema:name",
        "schema:version",
        "schema:license",
        "gaia:validity",
        "gaia:updateFrequency",
        "schema:variableMeasured",
        "gaia:representation",
        "schema:subjectOf"
