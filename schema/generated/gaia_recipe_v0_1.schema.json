        "@type": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "cdif:isComposedOf": {
          "items": {
            "$ref": "#/$defs/ComponentPosition"
          },
          "minItems": 1,
          "type": "array"
        }
      },
