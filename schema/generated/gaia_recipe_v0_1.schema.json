            "array",
            "null"
          ]
        },
        "schema:description": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema:maxValue": {
          "type": [
            "number",
            "null"
          ]
        },
        "schema:minValue": {
          "type": [
            "number",
            "null"
          ]
        },
        "schema:name": {
          "type": "string"
        },
        "schema:propertyID": {
          "items": {
            "$ref": "#/$defs/IriRef"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "schema:unitCode": {
          "description": "A QUDT unit URI (or a UCUM code). Not an OMOP concept id.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema:name",
        "cdif:role",
        "cdif:physicalDataType"
      ],
      "title": "Variable",
      "type": "object"
