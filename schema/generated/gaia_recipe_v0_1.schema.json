      "properties": {
        "@id": {
          "type": "string"
        }
      },
      "required": [
        "@id"
      ],
      "title": "IriRef",
      "type": "object"
    },
    "JoinsTo": {
      "additionalProperties": false,
      "description": "",
      "properties": {
        "gaia:joinKey": {
          "pattern": "^\\S+$",
          "type": "string"
        },
        "gaia:table": {
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        "gaia:targetKey": {
          "pattern": "^\\S+$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "gaia:table",
        "gaia:joinKey"
      ],
      "title": "JoinsTo",
      "type": "object"
    },
    "Key": {
      "additionalProperties": false,
      "description": "",
