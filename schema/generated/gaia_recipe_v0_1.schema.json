            "string",
            "null"
          ]
        },
        "gaia:representation": {
          "$ref": "#/$defs/RepresentationEnum"
        },
        "gaia:retrieval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Retrieval"
            },
            {
              "type": "null"
            }
          ]
