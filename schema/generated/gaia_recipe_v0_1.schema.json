        {
          "if": {
            "properties": {
              "gaia:representation": {
                "const": "vector"
              }
            },
            "required": [
              "gaia:representation"
            ]
          },
          "then": {
            "properties": {
              "geosparql:crs": {},
              "gaia:geometryType": {},
              "gaia:labelColumn": {}
            },
            "required": [
              "gaia:geometryType",
              "gaia:labelColumn",
              "geosparql:crs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "gaia:representation": {
                "const": "raster"
              }
            },
            "required": [
              "gaia:representation"
            ]
          },
          "then": {
            "properties": {
              "geosparql:crs": {},
              "gaia:files": {}
            },
            "required": [
              "geosparql:crs",
              "gaia:files"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "gaia:representation": {
                "const": "table"
              }
            },
            "required": [
              "gaia:representation"
            ]
          },
          "then": {
            "properties": {
              "gaia:joinsTo": {}
            },
            "required": [
              "gaia:joinsTo"
            ]
          }
        }
