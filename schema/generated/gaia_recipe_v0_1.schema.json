        "gaia:engine": {
          "$ref": "#/$defs/TransformEngineEnum"
        },
        "gaia:reason": {
          "type": "string"
        },
        "gaia:script": {
          "type": "string"
        }
      },
      "required": [
        "gaia:engine",
