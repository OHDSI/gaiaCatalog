      },
      "required": [
        "gaia:method",
        "gaia:inputs"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "DerivationMethodEnum": {
      "description": "",
      "enum": [
        "subset",
        "clip",
        "voronoi",
        "buffer",
        "temporal_combine"
      ],
      "title": "DerivationMethodEnum",
      "type": "string"
    },
    "FileEntry": {
      "additionalProperties": false,
      "description": "",
      "properties": {
        "gaia:band": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "gaia:layer": {
