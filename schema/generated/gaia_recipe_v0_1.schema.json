            "properties": {
              "gaia:url": {}
            },
            "required": [
              "gaia:url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "gaia:method": {
                "const": "download_unzip"
              }
            },
            "required": [
              "gaia:method"
            ]
          },
          "then": {
            "properties": {
              "gaia:url": {}
            },
            "required": [
              "gaia:url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "gaia:method": {
                "const": "api_query"
              }
            },
            "required": [
              "gaia:method"
            ]
          },
          "then": {
            "properties": {
              "gaia:url": {}
            },
            "required": [
              "gaia:url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "gaia:method": {
                "const": "arcgis_featureserver"
              }
            },
            "required": [
              "gaia:method"
            ]
          },
          "then": {
            "properties": {
              "gaia:url": {}
            },
            "required": [
              "gaia:url"
            ]
          }
