{
  "$defs": {
    "Any": {
      "additionalProperties": true,
      "description": "",
      "title": "Any",
      "type": [
        "null",
        "boolean",
        "object",
        "number",
        "string"
      ]
    },
    "CatalogRecord": {
      "additionalProperties": false,
      "description": "The catalog record, which says which profiles the recipe follows.",
      "properties": {
        "dcterms:conformsTo": {
          "items": {
            "$ref": "#/$defs/IriRef"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "dcterms:conformsTo"
      ],
      "title": "CatalogRecord",
      "type": "object"
    },
    "CodeLabel": {
      "additionalProperties": false,
      "description": "",
      "properties": {
        "gaia:code": {
          "type": "string"
        },
        "gaia:label": {
          "type": "string"
        }
      },
      "required": [
        "gaia:code",
        "gaia:label"
      ],
      "title": "CodeLabel",
      "type": "object"
    },
    "ComponentPosition": {
      "additionalProperties": false,
      "description": "",
      "properties": {
        "@type": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "cdi:indexes": {
          "$ref": "#/$defs/IriRef"
        },
        "cdi:value": {
          "type": "integer"
        }
      },
      "required": [
        "cdi:indexes",
        "cdi:value"
      ],
      "title": "ComponentPosition",
      "type": "object"
    },
    "CrsRef": {
      "additionalProperties": false,
      "description": "A reference to an EPSG coordinate reference system by URI.",
      "properties": {
        "@id": {
          "pattern": "^http://www\\.opengis\\.net/def/crs/EPSG/0/\\d+$",
          "type": "string"
        }
      },
      "required": [
        "@id"
      ],
      "title": "CrsRef",
      "type": "object"
    },
    "DataDownload": {
      "additionalProperties": false,
      "description": "",
      "properties": {
        "@type": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "schema:contentUrl": {
          "type": "string"
        },
        "schema:encodingFormat": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema:contentUrl"
      ],
      "title": "DataDownload",
      "type": "object"
    },
    "Derivation": {
      "additionalProperties": false,
      "description": "",
      "properties": {
        "gaia:inputs": {
          "items": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "gaia:method": {
          "$ref": "#/$defs/DerivationMethodEnum"
