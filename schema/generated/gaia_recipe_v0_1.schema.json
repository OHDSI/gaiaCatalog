      "description": "",
      "enum": [
        "single",
        "column_per_period",
        "long",
        "jsonb_series",
        "file_per_period"
      ],
      "title": "LayoutEnum",
      "type": "string"
    },
    "PeriodValidity": {
      "additionalProperties": false,
      "description": "The period the values stand for.",
      "properties": {
        "gaia:end": {
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
          "type": "string"
        },
        "gaia:layout": {
          "$ref": "#/$defs/LayoutEnum"
        },
        "gaia:start": {
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
          "type": "string"
        }
      },
      "required": [
        "gaia:start",
        "gaia:end"
      ],
      "title": "PeriodValidity",
      "type": "object"
    },
    "PhysicalDataTypeEnum": {
      "description": "Database and raster value types (not QUDT or UCUM; units are separate).",
      "enum": [
        "varchar",
        "text",
        "int2",
        "int4",
        "int8",
        "float4",
        "float8",
        "numeric",
        "jsonb",
        "date",
        "timestamp",
        "boolean",
        "uint8",
        "uint16",
        "int16",
        "float32"
      ],
      "title": "PhysicalDataTypeEnum",
      "type": "string"
    },
    "Recipe": {
      "additionalProperties": false,
