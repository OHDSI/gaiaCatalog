        "gaia:method": {
          "$ref": "#/$defs/RetrievalMethodEnum"
        },
        "gaia:transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ]
