          "anyOf": [
            {
              "$ref": "#/$defs/CrsRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema:description": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema:distribution": {
          "items": {
            "$ref": "#/$defs/DataDownload"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "schema:identifier": {
          "$ref": "#/$defs/Identifier"
        },
        "schema:license": {
          "items": {
            "type": "string"
