                    ]
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "name"
            ],
            "title": "Place",
            "type": "object"
        },
        "PropertyValue": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "@type": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "propertyID": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "unitText": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "url": {
                    "pattern": "^https?://\\S+$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "value": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Any"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "title": "PropertyValue",
            "type": "object"
        },
        "Role": {
            "additionalProperties": false,
            "description": "",
            "properties": {
                "@type": {
                    "const": "Role",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "creator": {
                    "$ref": "#/$defs/Agent"
                },
                "roleName": {
                    "type": "string"
                }
            },
            "required": [
                "roleName",
                "creator"
            ],
            "title": "Role",
            "type": "object"
        },
        "StatusEnum": {
            "description": "The creativeWorkStatus of the entry.",
            "enum": [
                "draft",
                "published",
                "deprecated"
            ],
            "title": "StatusEnum",
            "type": "string"
        },
        "TermSetEnum": {
            "description": "The term sets that measurementTechnique draws on.",
            "enum": [
                "dataRepresentation",
                "vectorGeometry",
                "dataProcessingLevel"
            ],
            "title": "TermSetEnum",
            "type": "string"
        },
        "Variable": {
            "additionalProperties": false,
            "description": "One variable (an entry of variableMeasured).",
            "properties": {
                "@type": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "additionalProperty": {
                    "items": {
                        "$ref": "#/$defs/PropertyValue"
                    },
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "alternateName": {
                    "description": "The OMOP concept id of the variable, as text.",
                    "pattern": "^\\d+$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "description": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "identifier": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PropertyValue"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "maxValue": {
                    "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "minValue": {
                    "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "name": {
                    "type": "string"
                },
                "qudt:dataType": {
                    "pattern": "^xsd:[A-Za-z0-9_]+$",
                    "type": "string"
                },
                "sourceOrganization": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Agent"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "unitCode": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "unitText": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "required": [
                "name",
                "qudt:dataType"
            ],
            "title": "Variable",
            "type": "object"
        }
