    "$id": "https://w3id.org/ohdsi/gaiacatalog/schema/v2",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": false,
    "description": "One file holding an @context and an @graph with one Dataset.",
    "metamodel_version": "1.12.0",
    "properties": {
        "@context": {
            "$ref": "#/$defs/Any"
        },
        "@graph": {
            "items": {
                "$ref": "#/$defs/Dataset"
            },
            "maxItems": 1,
            "minItems": 1,
            "type": "array"
        }
    },
    "required": [
        "@context",
        "@graph"
    ],
    "title": "gaia_catalog_v2",
    "type": "object",
    "version": null
}

