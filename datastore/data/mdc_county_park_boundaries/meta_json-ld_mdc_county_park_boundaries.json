        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_county_park_boundaries/download -p /data/mdc_county_park_boundaries/etl\n  chmod -R 777 /data/mdc_county_park_boundaries\n  cd /data/mdc_county_park_boundaries\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget --retry-connrefused --waitretry=1 --read-timeout=20 --timeout=15 -t 10 -O download/mdc_county_park_boundaries.geojson 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/CountyParkBoundaries_PROS_View_for_ALWAYS_ON/FeatureServer/1/query?outFields=*&where=1%3D1&spatialRefId=4326&f=geojson' 2>&1\n  \n  # load into postGIS with:\n  ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_county_park_boundaries.geojson -nlt multipolygon -nln mdc_county_park_boundaries\n  echo success: mdc_county_park_boundaries.geojson loaded with ogr2ogr\n  \n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_county_park_boundaries\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  ALTER TABLE mdc_county_park_boundaries DROP COLUMN IF EXISTS geom_local CASCADE;\n  SELECT AddGeometryColumn (\n    'mdc_county_park_boundaries',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_county_park_boundaries\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_county_park_boundaries_geom_local_idx\n    ON mdc_county_park_boundaries\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';"
        },
