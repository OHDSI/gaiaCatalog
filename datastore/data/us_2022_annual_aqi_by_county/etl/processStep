ALTER TABLE us_2022_annual_aqi_by_county ADD COLUMN n90th_percentile_aqi int4;
UPDATE us_2022_annual_aqi_by_county SET n90th_percentile_aqi=temp.n90th_percentile_aqi::int4
  FROM temp
