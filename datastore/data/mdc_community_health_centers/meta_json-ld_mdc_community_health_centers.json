        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_community_health_centers/download -p /data/mdc_community_health_centers/etl\n  chmod -R 777 /data/mdc_community_health_centers\n  cd /data/mdc_community_health_centers\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln mdc_community_health_centers download/mdc_community_health_centers.geojson 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/PaGISView_gdb/FeatureServer/0/query?where=DOR_DESC=%27CHARITABLE%20-%20EXEMPT%20:%20HEALTH%20CARE%27&outFields=*&outSR=4326&f=json&orderBy=ObjectId 2>&1'\n  \n  # load into postGIS with:\n  ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_community_health_centers.geojson -nlt point -nln mdc_community_health_centers\n  echo success: mdc_community_health_centers.geojson loaded with ogr2ogr\n  \n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_community_health_centers\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  ALTER TABLE mdc_community_health_centers DROP COLUMN IF EXISTS geom_local CASCADE;\n  SELECT AddGeometryColumn (\n    'mdc_community_health_centers',\n    'geom_local', 2236, 'point', 2\n  );\n  UPDATE mdc_community_health_centers\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,2236)));\n  CREATE INDEX mdc_community_health_centers_geom_local_idx\n    ON mdc_community_health_centers\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_community_health_centers/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_community_health_centers/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gaia-db -t mdc_community_health_centers > derived/mdc_community_health_centers.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_community_health_centers.sql.tar.gz\n  tar -czf derived/mdc_community_health_centers.sql.tar.gz meta_dcat_mdc_community_health_centers.json -C derived mdc_community_health_centers.sql"
        },
