    "lineage": "TBD",
    "process_step": "#########\n# GDSC ETL is performed in two steps: shell script to ETL data into postgres\n# and then additional transformations with SQL in postGIS (if needed).\n####\n\n#########\n# Step 1 - bash script (pseudo code)\n####\n\n# create directory structure and move into it\nmkdir -p /data/us_2020_zcta/download -p /data/us_2020_zcta/etl\nchmod -R 777 /data/us_2020_zcta\ncd /data/us_2020_zcta\n\n# set update flag based on last update and update frequency\ndo_update=0 if date() < last_update + update_frequency else do_update = 1\n\n# download if update flag is set:\nif do_update == 1 then\nwget --retry-connrefused --waitretry=1 --read-timeout=20 --timeout=15 -t 10 -O download/us_2020_zcta.zip 'ftp://ftp2.census.gov/geo/tiger/TIGER2020/ZCTA520/tl_2020_us_zcta520.zip' 2>&1\n\n# unzip to download directory if update flag is set\nif do_update == 1 then\nunzip -o download/us_2020_zcta.zip -d download && rm download/us_2020_zcta.zip 2>&1\n\n# load into postGIS with:\nogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/tl_2020_us_zcta520.shp -nlt multipolygon -nln us_2020_zcta\necho success: tl_2020_us_zcta520.shp loaded with ogr2ogr\n\n\n#########\n# Step 2 - SQL script (pseudo code):\n####\n\n# remove duplicate points and make geometries valid:\nUPDATE us_2020_zcta\n  SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n\n# add local geometry column and reproject existing geometries into local EPSG:\nALTER TABLE us_2020_zcta DROP COLUMN IF EXISTS geom_local CASCADE;\nSELECT AddGeometryColumn (\n  'us_2020_zcta',\n  'geom_local', 4269, 'multipolygon', 2\n);\nUPDATE us_2020_zcta\n  SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),4269)));\nCREATE INDEX us_2020_zcta_geom_local_idx\n  ON us_2020_zcta\n  USING GIST (geom_local);\nNOTIFY pgrst, 'reload schema';\n",
    "processor": "GDSC automation (see Process Step)",
