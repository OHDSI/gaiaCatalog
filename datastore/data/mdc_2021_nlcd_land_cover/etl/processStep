#########
# GDSC ETL is performed in two steps: shell script to ETL data into postgres
# and then additional transformations with SQL in postGIS (if needed).
####

#########
# Step 1 - bash script (pseudo code)
####

# create directory structure and move into it
mkdir -p /data/mdc_2021_nlcd_land_cover/download -p /data/mdc_2021_nlcd_land_cover/etl
chmod -R 777 /data/mdc_2021_nlcd_land_cover
cd /data/mdc_2021_nlcd_land_cover

# set update flag based on last update and update frequency
do_update=0 if date() < last_update + update_frequency else do_update = 1

# load us_2021_nlcd_land_cover as dependency (see us_2021_nlcd_land_cover for details).

# clip raster with geometry as:
  gdalwarp -cutline PG:"<postgres connection>" -csql "SELECT geom FROM fl_2022_tl_cousub WHERE countyfp='086'" -crop_to_cutline -s_srs '+proj=aea +lat_0=23 +lon_0=-96 +lat_1=29.5 +lat_2=45.5 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs' -t_srs EPSG:4326 /data/us_2021_nlcd_land_cover/download/Annual_NLCD_LndCov_2021_CU_C1V1.tif download/mdc_2021_nlcd_land_cover.tif
 
#########
# Step 2 - SQL script (pseudo code):
####

# load raster into postGIS with:
    raster2pgsql -s 4326 -d -C -I -t 56x56 mdc_2021_nlcd_land_cover.tif -F mdc_2021_nlcd_land_cover > load_raster.sql
psql <connection options> < load_raster.sql
rm load_raster.sql


